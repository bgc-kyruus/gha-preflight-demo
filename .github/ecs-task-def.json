{
  "family": "gha-preflight-demo-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::093728559318:role/GHAECSExecutionRole", 
  "taskRoleArn": "arn:aws:iam::093728559318:role/GHAECSExecutionRole",
  "containerDefinitions": [
    {
      "name": "gha-preflight-demo",
      "image": "${IMAGE_URI}", 
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}

